# ─── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Orígenes permitidos por CORS, separados por coma.
# En producción es obligatorio: sin esto la API no acepta navegadores.
CORS_ORIGINS=http://localhost:5173

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# Opción A: cadena completa (tiene prioridad sobre los campos sueltos)
DATABASE_URL=

# Opción B: campos sueltos
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=seminuevos
# "require" en proveedores gestionados (DigitalOcean, Render, Neon…)
PG_SSL=

# ─── Autenticación ─────────────────────────────────────────────────────────
# Obligatorio. Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# ─── Paginación ────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── Job de seguimiento automático ─────────────────────────────────────────
# Desactivar en réplicas adicionales para no duplicar mensajes al cliente.
FOLLOWUP_ENABLED=true
FOLLOWUP_INTERVAL_MS=60000
FOLLOWUP_AFTER_HOURS=23
